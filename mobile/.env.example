# Copie este arquivo para mobile/.env. Ele não contém senhas nem um IP pessoal.
# O valor abaixo funciona no Expo Web aberto neste mesmo computador.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
#
# APARELHO FÍSICO: substitua localhost pelo IPv4 Wi-Fi do computador que executa
# o Spring Boot. Consulte ipconfig (Windows) ou as configurações de rede.
# Modelo: http://IP_DO_COMPUTADOR:8080/api — substitua IP_DO_COMPUTADOR pelo IP real.
# Computador e aparelho devem estar na mesma rede; permita a porta 8080 no firewall.
# ANDROID EMULATOR padrão: use http://10.0.2.2:8080/api
# SIMULADOR iOS local: use http://localhost:8080/api
#
# Preserve /api e ajuste 8080 se o backend usar outra porta. Confira o endereço
# no navegador do aparelho com /status antes de abrir o aplicativo.
# Reinicie o Expo após qualquer alteração: npm start -- --clear --port 8081
# EXPO_PUBLIC_* é público no aplicativo: nunca coloque credenciais aqui.
# Sem EXPO_PUBLIC_API_URL, o app tenta detectar o computador pelo host do Expo.
